[Unit]
Description=Reel Studio Worker
After=network.target postgresql.service
[Service]
EnvironmentFile=/etc/reelstudio/env
WorkingDirectory=/opt/reelstudio
ExecStart=/opt/reelstudio/.venv/bin/reelstudio worker
Restart=on-failure
User=reelstudio
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
