# Copy to .env (git-ignored). Never commit real values.
RS_DATABASE_URL=sqlite:///./data/reelstudio.db
# Production: postgresql+psycopg://user:pass@localhost:5432/reelstudio
RS_DATA_DIR=./data
# Dashboard/API bearer token (required to use the API). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
RS_DASHBOARD_TOKEN=
# Fernet key encrypting stored Instagram tokens. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
RS_SECRET_KEY=
# AI provider: "local" (offline seed writer) or "anthropic"
RS_AI_PROVIDER=local
RS_ANTHROPIC_API_KEY=
RS_ANTHROPIC_MODEL=claude-sonnet-5-5
# Meta / Instagram (Instagram API with Instagram Login)
RS_META_APP_ID=
RS_META_APP_SECRET=
RS_META_REDIRECT_URI=https://YOUR_HOST/api/instagram/callback
RS_GRAPH_VERSION=v21.0
# Publicly reachable base URL under which /media/ is served (Instagram fetches video_url from here)
RS_PUBLIC_BASE_URL=
